 dep_option(SDL_KMSDRM_SHARED       "Dynamically load KMS DRM support" ON "SDL_KMSDRM" OFF)
 set_option(SDL_OFFSCREEN           "Use offscreen video driver" ON)
+set_option(SDL_MINI                "Use the Miyoo Mini (SSD202D) video, render and audio drivers" OFF)
 option_string(SDL_BACKGROUNDING_SIGNAL "number to use for magic backgrounding signal or 'OFF'" OFF)
 option_string(SDL_FOREGROUNDING_SIGNAL "number to use for magic foregrounding signal or 'OFF'" OFF)
 set_option(SDL_HIDAPI              "Enable the HIDAPI subsystem" ON)
@@ -1264,6 +1265,36 @@ if(SDL_VIDEO)
   endif()
 endif()
 
+# Miyoo Mini (SigmaStar SSD202D). Video, render and audio in one option because
+# they are one driver set: the render backend blits through the video driver's
+# MI_GFX context, and the audio driver includes the video driver's header for it.
+#
+# The sources are not upstream's. They are grafted in from
+# platform/miyoomini/sdl2/ before this file is configured; see that directory's
+# PROVENANCE.md for their origin and licence.
+if(SDL_MINI)
+  set(SDL_VIDEO_DRIVER_MINI 1)
+  set(SDL_VIDEO_RENDER_MINI 1)
+  set(SDL_AUDIO_DRIVER_MINI 1)
+  file(GLOB MINI_SOURCES
+    ${SDL2_SOURCE_DIR}/src/video/mini/*.c
+    ${SDL2_SOURCE_DIR}/src/render/mini/*.c
+    ${SDL2_SOURCE_DIR}/src/audio/mini/*.c)
+  if(NOT MINI_SOURCES)
+    message(FATAL_ERROR "SDL_MINI is ON but no src/{video,render,audio}/mini sources are present.")
+  endif()
+  list(APPEND SOURCE_FILES ${MINI_SOURCES})
+  # The vendor SDK lives in the toolchain sysroot, so no include path is needed
+  # for the headers; the libraries are named explicitly.
+  list(APPEND EXTRA_LIBS mi_gfx mi_ao mi_sys mi_common shmvar)
+  set(HAVE_SDL_VIDEO TRUE)
+  set(HAVE_SDL_AUDIO TRUE)
+  # SDL summarises every set_option() as HAVE_<name minus the SDL_ prefix>.
+  # Without this the configure output reports "SDL_MINI (Wanted: ON): OFF" for
+  # drivers that are in fact compiled in.
+  set(HAVE_MINI ON)
+endif()
+
 # Platform-specific options and settings
 if(ANDROID)
   file(GLOB ANDROID_CORE_SOURCES ${SDL2_SOURCE_DIR}/src/core/android/*.c)
