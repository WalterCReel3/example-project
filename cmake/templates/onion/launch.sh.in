#!/bin/sh
#
# OnionOS entrypoint for @WREEL_BUNDLE_BINARY@ — generated by
# cmake/Packaging.cmake from cmake/templates/onion/launch.sh.in. Do not edit the
# copy on the SD card; it is overwritten every time the bundle is rebuilt.
#
# Reasoning for each step is in planning/2026-07-27-onion-bundle/.

cd "$(dirname "$0")" || exit 1

# Everything from here into one file, truncated per run.
#
# Redirecting the whole script rather than piping the last command matters: a
# failed guard, a loader error or a crash before main() all land here too, and
# the first device runs lost exactly those. Truncating rather than appending is
# also deliberate — the first log read back off a device interleaved two runs
# and the stale half was read as current.
exec >stdout.log 2>&1

echo "=== coppers launch ==="
date 2>/dev/null
uname -a
echo "pwd=$PWD"
echo "HOME=$HOME"
echo "LD_PRELOAD=${LD_PRELOAD:-<unset>}"
ls -l ./@WREEL_BUNDLE_BINARY@ 2>&1
ls -l lib 2>&1

# Onion preloads libpadsp.so, its audio shim, into launched programs. Its own
# ports launcher unsets it before exec'ing the game; this does the same, because
# a shim that hooks audio calls underneath an SDL2 that talks to MI_AO directly
# is a conflict rather than a help.
unset LD_PRELOAD

# ---------------------------------------------------------------------------
# local.env — the knobs, editable on the device
# ---------------------------------------------------------------------------
#
# MainUI launches this script with no arguments and no environment, so a shell
# prefix only works over SSH. Anything that needs changing from the Apps menu
# goes here instead.
#
# This file is NOT generated and NOT overwritten by a bundle rebuild, so it
# survives redeploying. Create it beside this script with a text editor on
# whatever machine has the SD card in it:
#
#     # App/Coppers/local.env
#     SDL_RENDER_DRIVER=software
#     COPPERS_ARGS="--cpu-scroller --no-hud --seconds 20 --fps 0"
#
# SDL_RENDER_DRIVER is SDL's own hint, read straight from the environment. This
# device's SDL2 carries two render backends: `mini`, which is MI_GFX-accelerated
# but implements only a full-screen copy and rotates it, and `software`, which
# is SDL's real one — slower per pixel, but correct for sub-rect blits, fills
# and read-back. Naming one here is how they get compared without a rebuild.
if [ -f local.env ]; then
    echo "--- local.env ---"
    cat local.env

    # `set -a` matters and is not decoration. A sourced `FOO=bar` sets a SHELL
    # variable, and a child process is handed the ENVIRONMENT — so without this
    # anything in that file aimed at coppers is silently dropped, while the
    # launcher's own echo of it still prints the value. That is precisely how
    # the first SDL_RENDER_DRIVER=software run failed: the log said `software`
    # and the program was never told.
    #
    # COPPERS_ARGS is unaffected either way, because the shell expands that one
    # itself. Which is what made the failure look like SDL ignoring the hint.
    set -a
    # shellcheck source=/dev/null
    . ./local.env
    set +a
fi

# ---------------------------------------------------------------------------
# The audio device
# ---------------------------------------------------------------------------
#
# MI_AO is single-owner, and on Onion the owner is `audioserver`. With it
# running, opening audio fails in the vendor layer before SDL sees it:
#
#   [MI ERR ]: MI_AO_SetPubAttr[3364]: Dev0 failed to set pub attr!!!
#              error number:0xa0052009!!!
#
# The firmware ships the remedy and its own ports use it, gated on a
# KillAudioserver flag. Same script, so the behaviour matches what every other
# port on this device does.
#
# MainUI restarts the server when it comes back. If it does not, a reboot will.
# Set COPPERS_KILL_AUDIOSERVER=0 to leave it alone and run without sound —
# audio::Device already tolerates a mixer that will not open.
stop_audio=/mnt/SDCARD/.tmp_update/script/stop_audioserver.sh

# That script is normally sourced from Onion's runtime.sh, which sets $miyoodir.
# Sourced from anywhere else it is unset, and one branch of the script — the one
# that handles wpa_supplicant and udhcpc holding MI_AO open through a preloaded
# libpadsp.so — kills both and restarts them from "$miyoodir/app/...". With the
# variable empty that restart cannot work, and the cost of finding out is the
# wifi going down, taking SSH with it, mid-run. Same value as runtime.sh.
: "${miyoodir:=/mnt/SDCARD/miyoo}"
export miyoodir

if [ "${COPPERS_KILL_AUDIOSERVER:-1}" = "1" ] && [ -f "$stop_audio" ]; then
    echo "--- stopping audioserver (miyoodir=$miyoodir) ---"
    # shellcheck source=/dev/null
    . "$stop_audio"
elif [ "${COPPERS_KILL_AUDIOSERVER:-1}" = "1" ]; then
    echo "--- $stop_audio not found; audio will likely fail ---"
fi

# ---------------------------------------------------------------------------
# SDL2
# ---------------------------------------------------------------------------
#
# Upstream SDL2 has no video driver that can reach this panel: the SSD202D has
# no DRM device and SDL2 has no framebuffer backend, so a statically linked
# upstream build can only select `dummy`. What works here is an SDL2 with the
# mmiyoo driver, which talks to SigmaStar's MI_GFX.
#
# That library ships in lib/ beside this script rather than being borrowed from
# the firmware. The firmware's own copy, under .tmp_update/lib/parasyte, needs a
# Mesa/X11/libdrm stack and a matched loader and libc — it is an alternate
# userland for binaries built against a newer glibc, and this one is built
# against the device's own 2.28. Onion's native SDL2 ports vendor their runtime
# the same way for the same reason.
#
# /customer/lib stays on the path because libmi_gfx, libmi_ao, libmi_sys and
# libshmvar are the firmware's, and must be.
if [ ! -f lib/libSDL2-2.0.so.0 ]; then
    echo "launch: lib/libSDL2-2.0.so.0 is missing — this bundle was built"
    echo "        without a runtime. See planning/2026-07-27-onion-bundle/."
    exit 1
fi

export LD_LIBRARY_PATH="$PWD/lib:/customer/lib:$LD_LIBRARY_PATH"

# SDL_VIDEODRIVER and SDL_AUDIODRIVER are deliberately NOT set. The two mmiyoo
# SDL2 builds in circulation disagree on the name — Onion's copy registers
# `mmiyoo`, steward-fu's prebuilt registers `mini` — and each compiles in
# exactly one video and one audio driver, so letting SDL choose selects the only
# candidate there is. coppers logs which one it got.
#
# There is no headless option with any of them: `dummy` and `offscreen` are
# disabled in these builds, so every run goes through MI_GFX. The statically
# linked binary is the one that can run headless.

# What the loader resolves, before anything tries to use it. An unresolved
# library shows up here as "not found" instead of as a silent failure to start.
echo "--- library resolution ---"
LD_TRACE_LOADED_OBJECTS=1 ./@WREEL_BUNDLE_BINARY@ 2>&1

# ---------------------------------------------------------------------------
# Where the run gets recorded
# ---------------------------------------------------------------------------
#
# SDL_GetPrefPath resolves under $XDG_DATA_HOME or $HOME/.local/share, and HOME
# on a handheld is whatever init left it as. Pointing it at the bundle puts the
# log on the SD card, where it can be read over SFTP or in a card reader if the
# device will not boot far enough for SSH.
#
# WREEL_DATA_DIR is deliberately NOT set. rig::asset_path() logs which rule
# resolved the assets, and overriding it would mask a wrong bundle layout.
export HOME="$PWD"

echo "--- running ---"
echo "SDL_RENDER_DRIVER=${SDL_RENDER_DRIVER:-<unset, SDL picks>}"
echo "COPPERS_ARGS=${COPPERS_ARGS:-<none>}"

# COPPERS_ARGS is unquoted on purpose: it holds a command line, and MainUI has
# no way to pass one. Arguments given to this script still win, since they come
# afterwards.
# shellcheck disable=SC2086
./@WREEL_BUNDLE_BINARY@ $COPPERS_ARGS "$@"
status=$?
echo "--- exited $status ---"

# coppers logs to a dotted directory, which is invisible in most file managers
# and easy to miss over SFTP. Fold it into this file so one download has
# everything.
runlog=".local/share/wreel/coppers/coppers.log"

if [ -f "$runlog" ]; then
    echo "--- $runlog ---"
    cat "$runlog"
else
    echo "--- no $runlog was written ---"
fi

exit $status
