# Build trees (one per preset, see CMakePresets.json)
/build/
/build-*/
/out/

# Install / packaging output
/dist/
/pkg/

# Dependency source+build cache populated by FetchContent
/.cache/
/_deps/

# Toolchain container workspace mounts
/docker/*/workspace/
/docker/.build-*

# Editor / tooling
/.vscode/
/.idea/
/compile_commands.json
/.clangd/
/.cache/clangd/

# Claude Code: .claude/settings.json is shared and committed;
# per-user overrides and local state are not.
/.claude/settings.local.json
/.claude/*.local.json
*.swp
*.swo
tags
cscope.*

# Runtime artifacts produced by the demos
runlog.txt
*.log

# Per-device launcher overrides. cmake/templates/onion/launch.sh.in sources
# local.env beside the binary on the SD card; it is deliberately not generated
# and not part of the bundle, so a copy pulled back for inspection must not be
# committed either.
local.env

# Per-machine working notes: where the SDL2 runtime tree happens to sit, the
# container invocation with its mounts, and anything else true of one box rather
# than of the project. Facts about the project belong in docs/ instead.
local.md

core
core.*

# OS cruft
.DS_Store
Thumbs.db

# Python tooling in tools/ runs from a local virtualenv, rebuilt from
# tools/requirements.txt rather than committed.
/tools/.venv/
__pycache__/

# The Sunny Land pack as purchased: 5.9M of PSDs, .ase sources, preview GIFs and
# licence PDFs that nothing in the build reads. Its licence permits
# redistribution — this is a size decision, not a legal one. What the tree needs
# from it is committed: the frames tools/pack_atlas.py consumes are in
# data/sunny-land/, and the atlas it generates is data/foxy.{png,xml}. See
# data/PROVENANCE.md.
/data/Sunny-land-files/
/data/Sunny-land-files.zip
